// Modelagem do banco da Praso (Postgres no Supabase).
// Derivada de src/types/index.ts. Ver DIARIO-BORDO.md para as decisões.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EstablishmentStatus {
  lead
  oportunidade
  cliente
  churn
}

enum EstablishmentSegment {
  restaurante
  padaria
  lanchonete
  pizzaria
  hamburgueria
  cafeteria
  bar
}

enum DocumentType {
  MEI     @map("MEI")
  NAO_MEI @map("nao-MEI")
}

enum Potential {
  alto
  normal
  baixo
}

enum CategoriaFornecimento {
  carne
  pao
  bebidas
  laticinios
  hortifruti
  mercearia
  embalagens
  outros
}

enum Turno {
  manha
  tarde
  noite
}

enum VisitType {
  planejada
  efetiva
}

enum VisitResult {
  cadastrou
  recusou
  fechado
  ausente
  compra
  em_acompanhamento @map("em-acompanhamento")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Seller {
  id                 String   @id @default(uuid())
  nome               String
  pontuacaoAcumulada Float    @default(0)
  createdAt          DateTime @default(now())

  establishments Establishment[]
  visits         Visit[]
  purchases      Purchase[]

  @@map("sellers")
}

// Distribuidora é um cadastro compartilhado: a mesma pode fornecer vários estabelecimentos.
model Distribuidora {
  id            String         @id @default(uuid())
  nome          String         @unique
  createdAt     DateTime       @default(now())
  fornecimentos Fornecimento[]

  @@map("distribuidoras")
}

// Qual distribuidora fornece qual categoria a qual estabelecimento.
model Fornecimento {
  id              String                @id @default(uuid())
  establishmentId String
  distribuidoraId String
  categoria       CategoriaFornecimento
  createdAt       DateTime              @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  distribuidora Distribuidora @relation(fields: [distribuidoraId], references: [id])

  @@unique([establishmentId, distribuidoraId, categoria])
  @@index([establishmentId])
  @@map("fornecimentos")
}

model Establishment {
  id              String               @id @default(uuid())
  razaoSocial     String?
  nomeFantasia    String
  cnpj            String?              @unique
  segmento        EstablishmentSegment
  tipoDoc         DocumentType?
  potencial       Potential
  status          EstablishmentStatus  @default(lead)
  endereco        String
  latitude        Float?
  longitude       Float?
  // Precisão da coordenada: "poi" (ponto de interesse), "numero" (casa exata) ou "manual" (informada)
  geocodePrecisao String?
  telefone        String?
  bairro          String
  melhorHorario   String? // "HH:mm", quando souber
  melhorTurno     Turno? // último turno informado pelo vendedor
  notasContexto   String               @default("")
  // Pontos de aquisição já atribuídos a este estabelecimento (MEI 0.5, Não-MEI 1, alto potencial 3)
  score           Float                @default(0)
  vendedorId      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  vendedor      Seller?        @relation(fields: [vendedorId], references: [id])
  fornecimentos Fornecimento[]
  visits        Visit[]
  purchases     Purchase[]

  @@index([status])
  @@index([bairro])
  @@index([vendedorId])
  @@map("establishments")
}

// Histórico imutável: nunca é editado ou apagado. Correção se faz por anulação com motivo.
model Visit {
  id              String      @id @default(uuid())
  establishmentId String
  vendedorId      String
  dataHora        DateTime
  tipo            VisitType
  resultado       VisitResult
  // Geo (GPS automático). Opcional: visitas planejadas podem não ter.
  geoLat          Float?
  geoLng          Float?
  geoAccuracy     Float?
  nota            String      @default("")
  // Data combinada para o próximo contato (retorno ou acompanhamento)
  proximoContato  DateTime?
  melhorTurno     Turno?
  // Anulação com motivo (única forma de "alterar" uma visita)
  anuladaEm       DateTime?
  motivoAnulacao  String?
  // Pontos que esta visita gerou (aquisição + recorrência); usados para desfazer ao anular
  pontosGerados   Float       @default(0)
  createdAt       DateTime    @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  vendedor      Seller        @relation(fields: [vendedorId], references: [id])

  @@index([establishmentId, dataHora])
  @@index([vendedorId, dataHora])
  @@map("visits")
}

// Compra registrada. "autonoma" = feita no app sem apoio do vendedor (conta para a recorrência).
model Purchase {
  id              String   @id @default(uuid())
  establishmentId String
  vendedorId      String
  data            DateTime
  valor           Decimal  @db.Decimal(12, 2)
  autonoma        Boolean  @default(false)
  // Visita que originou a compra (null para compras lançadas direto na API)
  visitId         String?
  createdAt       DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  vendedor      Seller        @relation(fields: [vendedorId], references: [id])

  @@index([establishmentId, data])
  @@index([vendedorId])
  @@map("purchases")
}

// Observação: FollowUp não é tabela. Ele é calculado a partir de purchases
// (primeira compra + 45 dias, contagem de compras autônomas), como no backend atual.
